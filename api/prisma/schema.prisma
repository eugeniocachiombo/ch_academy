generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums para os status solicitados
enum Status {
  activo
  condicionado
  bloqueado
  cancelada
}

enum StatusAcademic {
  activa
  cancelada
  concluida
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  username  String     @unique @default("empty")
  email     String?
  password  String     @default("empty")
  status    String? // Ou pode usar o enum Status se preferir
  person_id Int? // nullable
  person    Person?    @relation(fields: [person_id], references: [id], onDelete: Cascade)
  persons   Person[]   @relation("UserPersons")
  userRoles UserRole[]
}

model Person {
  id         Int      @id @default(autoincrement())
  firstname  String
  middlename String
  lastname   String
  birthday   DateTime @db.Date()
  gender     String
  phone      Int

  user_id Int
  user    User @relation("UserPersons", fields: [user_id], references: [id], onDelete: Cascade)

  // Relação inversa opcional caso o User aponte para Person via person_id
  UserAsMain User[]

  student      Student?
  teacher      Teacher?
  localization Localization?
}

model AcademicYear {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  academicRegisters AcademicRegister[]
  status            StatusAcademic     @default(activa)
}

model Course {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  classes           Class[]
  subjects          Subject[]
  academicRegisters AcademicRegister[]
}

model Class {
  id   Int    @id @default(autoincrement())
  name String

  course_id Int?
  course    Course? @relation(fields: [course_id], references: [id], onDelete: Cascade)

  subjects          Subject[]
  academicRegisters AcademicRegister[]

  @@unique([name, course_id])
}

model Subject {
  id        Int    @id @default(autoincrement())
  name      String
  class_id  Int
  course_id Int? // nullable

  class  Class   @relation(fields: [class_id], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([name, class_id, course_id])
}

model Student {
  id                Int                @id @default(autoincrement())
  person_id         Int                @unique
  person            Person             @relation(fields: [person_id], references: [id], onDelete: Cascade)
  status            Status             @default(activo)
  academicRegisters AcademicRegister[]
}

model Teacher {
  id        Int    @id @default(autoincrement())
  person_id Int    @unique
  person    Person @relation(fields: [person_id], references: [id], onDelete: Cascade)
  status    Status @default(activo)
}

model AcademicRegister {
  id  Int @id @default(autoincrement())
  num Int // random

  academicYear_id Int
  academicYear    AcademicYear @relation(fields: [academicYear_id], references: [id], onDelete: Cascade)

  course_id Int
  course    Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  class_id Int
  class    Class @relation(fields: [class_id], references: [id], onDelete: Cascade)

  student_id Int
  student    Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  status StatusAcademic @default(activa)
}

model Role {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  userRoles      UserRole[]
  rolePermitions RolePermition[]
}

model Permition {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  rolePermitions RolePermition[]
}

model UserRole {
  id      Int  @id @default(autoincrement())
  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role_id Int
  role    Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
}

model RolePermition {
  id           Int       @id @default(autoincrement())
  role_id      Int
  role         Role      @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permition_id Int
  permition    Permition @relation(fields: [permition_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permition_id])
}

model Localization {
  id              Int     @id @default(autoincrement())
  person_id       Int     @unique
  person          Person  @relation(fields: [person_id], references: [id], onDelete: Cascade)
  province_id     Int
  municipality_id Int? // nullable
  address         String? // nullable
  naturality      Boolean // Naturality Boolean
}
